const isQX = typeof $task !== "undefined";
const isLoon = typeof $loon !== "undefined";
const isRequest = typeof $request !== "undefined";

const notify = (title, subtitle, message) => {
  if (typeof $notify !== "undefined") {
    $notify(title, subtitle, message);
  } else if (typeof $notification !== "undefined") {
    $notification.post(title, subtitle, message);
  }
};

const log = (msg) => console.log(msg);

const getVal = (key) => {
  if (typeof $prefs !== "undefined") return $prefs.valueForKey(key);
  if (typeof $persistentStore !== "undefined") return $persistentStore.read(key);
  return null;
};
const setVal = (key, val) => {
  if (typeof $prefs !== "undefined") return $prefs.setValueForKey(val, key);
  if (typeof $persistentStore !== "undefined") return $persistentStore.write(val, key);
  return null;
};

if (isRequest) {
  const headers = $request.headers;
  const url = $request.url;

  setVal("soul_sign_url", url);
  setVal("soul_sign_headers", JSON.stringify(headers));

  notify("蓝氏猫粮签到", "", "参数获取成功，脚本将在每天自动签到");
  $done({});
} else {
  const url = getVal("soul_sign_url");
  const headersRaw = getVal("soul_sign_headers");

  if (!url || !headersRaw) {
    notify("蓝氏猫粮签到失败", "", "未找到请求参数，请先手动签到一次获取参数");
    $done();
  } else {
    // 替换时间戳以确保请求有效
    const timestamp = new Date().getTime();
    const newUrl = url.replace(/timestamp=\d+/, `timestamp=${timestamp}`);
    
    const headers = JSON.parse(headersRaw);
    const request = { 
      url: newUrl, 
      method: "POST", 
      headers: headers,
      body: JSON.stringify({
        "appId": headers["appId"] || url.match(/appId=([^&]+)/)?.[1] || "",
        "openId": true,
        "shopNick": "",
        "timestamp": timestamp,
        "interfaceSource": 0,
        "activityId": "158245"
      })
    };

    const handleResponse = (body) => {
      try {
        const json = JSON.parse(body);
        const msg = json?.msg || json?.message || "无返回消息";
        const success = json?.success || json?.code === 200;

        log(`签到结果: ${success ? '成功' : '失败'}, 消息: ${msg}`);
        notify(success ? "蓝氏猫粮签到成功" : "蓝氏猫粮签到失败", "", msg);
      } catch (e) {
        log(`解析响应失败: ${e.toString()}`);
        notify("蓝氏猫粮签到失败", "", `解析响应失败: ${e.toString()}`);
      } finally {
        $done();
      }
    };

    if (isQX) {
      $task.fetch(request).then(
        (resp) => handleResponse(resp.body),
        (err) => {
          notify("Soul金币签到失败", "", `请求失败: ${JSON.stringify(err)}`);
          $done();
        }
      );
    } else if (isLoon) {
      $httpClient.post(request, (err, resp, data) => {
        if (err) {
          notify("蓝氏猫粮签到失败", "", `请求失败: ${JSON.stringify(err)}`);
          $done();
        } else {
          handleResponse(data);
        }
      });
    } else {
      notify("蓝氏猫粮签到", "", "不支持的运行环境");
      $done();
    }
  }
}
